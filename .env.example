# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars, signs candidate invite + phone pairing tokens: openssl rand -base64 32
TOKEN_SECRET=

# Supabase (Project Settings → API). Legacy anon/service_role or new publishable/secret keys both work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM: Gemini primary (aistudio.google.com/apikey), Groq fallback (console.groq.com/keys). At least one is required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# LiveKit Cloud (phone camera, needed from P4): cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars, signs candidate invite + phone pairing tokens: openssl rand -base64 32
TOKEN_SECRET=

# Supabase (Project Settings → API). Legacy anon/service_role or new publishable/secret keys both work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM: Groq only (console.groq.com/keys). Each tier falls back across models; Groq limits are per model.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Phone camera relay (optional, recommended for phones on mobile data / strict NATs).
# The phone link is plain WebRTC (STUN by default); add a free TURN server, comma-separated URLs:
#   e.g. Metered Open Relay / free tier: turn:<host>:80,turn:<host>:443,turns:<host>:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Not used by the current build (phone video uses WebRTC + Supabase Realtime signalling instead).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
